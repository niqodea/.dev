#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"
os="$("$root/.foundation/identify")"

# Run with the environment a new terminal will have, which a fresh machine does not have yet
. "$root/.foundation/profile"

if [ "$#" -eq 0 ]; then
    modules=$(find "$root/"* -maxdepth 0 -type d -exec basename {} \;)
else
    modules="$*"
fi

backup_path="$HOME/$DOTDEV_ATDIR/backups/$(date '+%Y_%m_%d-%H_%M_%S')"

for module in $modules; do
    module_path="$root/$module"

    if [ ! -d "$module_path" ]; then
        >&2 echo "Module $module not found"
        continue
    fi

    if [ ! -e "$module_path/install-bin" ]; then
        echo "Nothing to install for module $module"
        continue
    fi

    if [ -d "$module_path/submodules" ]; then
        echo "Fetching the submodules of module $module"
        git -C "$root" submodule update --init --depth 1 -- "$module_path/submodules"
    fi

    echo "Installing programs for module $module"
    "$module_path/install-bin" "$backup_path" "$os"

    if [ -e "$module_path/program-versions" ]; then
        ,copy-in-home "$backup_path" "$module_path/program-versions" "$DOTDEV_ATDIR/program-versions/$module"
    fi
done

if [ -e "$backup_path" ]; then
    echo "Backed up replaced files in $backup_path"
fi

,check-program-versions
