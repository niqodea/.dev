#!/bin/sh

set -eu

pane_type="$(tmux show-options -pv @pane_type)"
case "$pane_type" in
    zsh)
        ;;
    claude)
        # Claude is the pane's process, so killing it would close the pane
        tmux display-message "Pane runs Claude, it has no command to kill"
        exit
        ;;
    *)
        tmux display-message "Unknown pane type: $pane_type"
        exit
        ;;
esac

if [ "$(tmux show-options -pv @status)" = 'idle' ]; then
    tmux display-message 'Pane is idle'
    exit
fi

zsh_pid=$(tmux display-message -p '#{@zsh_pid}')
# The shell's oldest child is most likely the command it runs
if ! command_pid=$(pgrep -o -P "$zsh_pid"); then
    tmux display-message 'No command to kill found'
    exit
fi

# confirm-before needs a command to run, so it gets one that does nothing, and the kill comes after
if ! tmux confirm-before -p "Kill process $command_pid in pane?" 'send-keys ""'; then
    exit
fi

kill -9 "$command_pid" || {
    tmux display-message "Failed to send SIGKILL to process $command_pid"
    exit
}

tmux display-message "Sent SIGKILL to process $command_pid"
