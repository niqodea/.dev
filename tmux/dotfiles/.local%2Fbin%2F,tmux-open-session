#!/bin/sh

set -eu

# "=" for the exact name, since tmux otherwise matches a prefix of another one, and reads a bare "~" as the marked pane
if ! tmux has-session -t "=$1" 2> /dev/null; then
    if [ "$1" = '~' ]; then
        # The home session belongs to no project
        tmux new-session -d -n "" -s '~' -c "$HOME"
    elif [ -d "$HOME/$1/$DOTDEV_ATDIR/project" ]; then
        port_range="$(,get-project-port-range "$1")"
        tmux new-session -d -n "" -s "$1" -c "$HOME/$1" -e DOTDEV_PROJECT="$1" \
            -e DOTDEV_FIRST_PORT="${port_range% *}" -e DOTDEV_LAST_PORT="${port_range#* }"
    else
        >&2 echo "No project named $1"
        exit 1
    fi
fi

if [ -n "${TMUX-}" ]; then
    tmux switch-client -t "=$1"
else
    tmux attach-session -t "=$1"
fi
