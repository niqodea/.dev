#!/bin/sh

# Opens a session in the terminal this runs in: inside tmux it switches the client to the session, outside tmux it attaches the terminal to it

set -eu

# With -d, a width and a height, it only creates the session if it is missing, detached at that size
# Pass the size of the terminal that will open the session, since a shell started at another size draws its first prompt for that width
if [ "$1" = -d ]; then
    width="$2"
    height="$3"
    shift 3
fi
session="$1"

if [ "$session" = '~' ]; then
    # The home session belongs to no project
    set -- -s '~' -c "$HOME"
elif [ -d "$HOME/$session/$DOTDEV_ATDIR/project" ]; then
    # Every shell inside a project has DOTDEV_PROJECT set to the project's name
    set -- -s "$session" -c "$HOME/$session" -e DOTDEV_PROJECT="$session"
else
    >&2 echo "No project named $session"
    exit 1
fi

if [ -n "${width-}" ]; then
    if ! tmux has-session -t "=$session" 2> /dev/null; then
        tmux new-session -d -n "" -x "$width" -y "$height" "$@"
    fi
elif [ -n "${TMUX-}" ]; then
    # "=" for the exact name, since tmux otherwise matches a prefix of another one, and reads a bare "~" as the marked pane
    if ! tmux has-session -t "=$session" 2> /dev/null; then
        tmux new-session -d -n "" "$@"
    fi
    tmux switch-client -t "=$session"
elif tmux has-session -t "=$session" 2> /dev/null; then
    tmux attach-session -t "=$session"
else
    # Created attached, so it starts at the terminal's size, since a shell started at another size draws its first prompt for that width
    tmux new-session -n "" "$@"
fi
