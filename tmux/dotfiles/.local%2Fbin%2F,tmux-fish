#!/usr/bin/env python3
"""Label the matches on screen, and copy the one whose label is typed.

Opens a popup that covers the pane exactly and runs this script again with `pick`, which prints
the pane's text with labels over its matches, so they look drawn on the pane. Labels replace
characters instead of adding any, so every character stays in its column.
"""

import itertools
import os
import re
import subprocess
import sys
import tty
from typing import NamedTuple

# What a URL may hold, which stops at spaces, quotes and brackets
_URL = r"[^\s\"'`<>()\[\]{},;]"
# A path holds nothing before an =, as in --config=/etc/x
_PATH = r"[^\s\"'`<>()\[\]{},;=]"
# Each pattern claims the text it matches, and later patterns only match the text left
# A URL or a path ends before punctuation that can end a sentence
PATTERNS = [
    # URL
    re.compile(rf"[a-z][a-z0-9+.-]*://{_URL}+(?<![.:!?])"),
    # Email
    re.compile(r"[\w.+-]+@[\w-]+(?:\.[\w-]+)+"),
    # Path, which a lone / is not
    re.compile(rf"(?:{_PATH}+/|/{_PATH}){_PATH}*(?<![.:!?])"),
    # IP address, with an optional port
    re.compile(r"(?<![\w.])\d{1,3}(?:\.\d{1,3}){3}(?::\d+)?(?!\w)"),
    # UUID
    re.compile(
        r"(?<![\w-])[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}(?![\w-])", re.IGNORECASE
    ),
    # Git SHA, which holds a digit unlike hex words such as "defaced", and is not part of a longer name
    re.compile(r"(?<![\w-])(?=[0-9a-f]*\d)[0-9a-f]{7,40}(?![\w-])"),
    # Anything else long, like a secret or a pod name, which holds a digit unlike long words
    re.compile(r"(?<![\w-])(?=[\w-]*\d)[\w-]{12,}(?![\w-])"),
]

HOME_ROW = "asdfghjkl"
# q is never a label, so it always quits
ALPHABET = HOME_ROW + "wertyuiopzxcvbnm"

DIM = "\033[2m"
# Capitals stand out more than lowercase letters
LABEL = "\033[0;30;43m"
PLAIN = "\033[0m"


class Row(NamedTuple):
    """A row in view, as its index among the captured rows and where it starts and ends in its line."""

    index: int
    start: int
    end: int


class Line(NamedTuple):
    """A line that shows in view, as its whole text and its rows in view."""

    text: str
    rows: list[Row]


class Match(NamedTuple):
    """A match, as the index of its line, where it starts in the line, and its text."""

    line: int
    start: int
    text: str


def main() -> None:
    # Copy mode can show history, scrolled back by scroll_position lines, and is empty outside it
    scroll, width, height = run(
        [
            "tmux",
            "display-message",
            "-p",
            "#{e|+:0,#{scroll_position}} #{pane_width} #{pane_height}",
        ]
    ).split()
    # -F starts each row with its flags, where W marks a row that wraps onto the next one
    # -N keeps the spaces at the end of each row, since a row that wraps can end in a space of
    # the text
    # The whole history is captured, so a line that starts above the rows in view or ends below
    # them comes back whole
    captured = run(
        ["tmux", "capture-pane", "-p", "-N", "-F", "-S", "-", "-E", "-"]
    ).splitlines()
    first_in_view = len(captured) - int(height) - int(scroll)
    lines = join_rows(captured, range(first_in_view, first_in_view + int(height)))
    # A label has at most two letters, so a match shows only when two of its characters are in view
    matches = [
        match
        for match in find_matches(lines)
        if count_in_view(match, lines[match.line]) >= 2
    ]
    if not matches:
        run(["tmux", "display-message", "Nothing to fish on screen"])
        return
    if sys.argv[1:] != ["pick"]:
        # P puts the popup at the pane, and -EE keeps it open when the script fails, to show why
        popup = ["-B", "-EE", "-x", "P", "-y", "P", "-w", width, "-h", height]
        run(["tmux", "display-popup", *popup, sys.argv[0], "pick"])
        return

    # The longest matches, like URLs, are the likeliest to be copied, so they get the easiest labels
    # Among matches of one length, the newest output comes first, since matches are found bottom up
    texts = sorted(
        dict.fromkeys(match.text for match in matches), key=len, reverse=True
    )
    labels = dict(zip(texts, make_labels(len(texts))))
    draw(lines, matches, labels)

    tty.setcbreak(sys.stdin.fileno())
    typed = read_key()
    # A key that starts no label, like q or Escape, quits without waiting for a second one
    if not any(label.startswith(typed) for label in labels.values()):
        return
    if len(next(iter(labels.values()))) == 2:
        typed += read_key()
    match = next((text for text, label in labels.items() if label == typed), None)
    if match is not None:
        subprocess.run([",clipboard", "write"], input=match, text=True, check=True)
        run(["tmux", "display-message", "-l", f"Copied {match}"])


def join_rows(captured: list[str], in_view: range) -> list[Line]:
    """Join the captured rows into lines, and keep the lines with rows in view.

    A long match like a URL can wrap across rows, and only the whole line holds all of it.
    """
    lines = []
    text = ""
    rows = []
    for index, row in enumerate(captured):
        flags, _, row_text = row.partition(" ")
        if index in in_view:
            rows.append(Row(index, len(text), len(text) + len(row_text)))
        text += row_text
        # The last row ends its line, since no row follows it
        if "W" not in flags or index == len(captured) - 1:
            if rows:
                lines.append(Line(text, rows))
            text = ""
            rows = []
    return lines


def find_matches(lines: list[Line]) -> list[Match]:
    """Find the matches in each line, from the bottom line up."""
    matches = []
    for index in reversed(range(len(lines))):
        rest = lines[index].text
        found = []
        for pattern in PATTERNS:
            for match in pattern.finditer(rest):
                found.append(Match(index, match.start(), match.group()))
                # Spaces in place of a claimed match keep later patterns off it
                rest = (
                    rest[: match.start()]
                    + " " * len(match.group())
                    + rest[match.end() :]
                )
        matches.extend(sorted(found))
    return matches


def count_in_view(match: Match, line: Line) -> int:
    """Count the characters of the match on the line's rows in view."""
    first = max(match.start, line.rows[0].start)
    end = min(match.start + len(match.text), line.rows[-1].end)
    return end - first


def make_labels(count: int) -> list[str]:
    """Make `count` labels, all one letter or all two, so that no label starts another."""
    if count <= len(ALPHABET):
        return list(ALPHABET[:count])
    # Two letters come from the home row while it has enough pairs
    letters = HOME_ROW if count <= len(HOME_ROW) ** 2 else ALPHABET
    return ["".join(pair) for pair in itertools.product(letters, repeat=2)][:count]


def draw(lines: list[Line], matches: list[Match], labels: dict[str, str]) -> None:
    out = []
    for index, line in enumerate(lines):
        # The characters and their styles are kept for the whole line, so a match keeps its
        # style on every row it wraps across
        chars = list(line.text)
        styles = [DIM] * len(chars)
        for match in (match for match in matches if match.line == index):
            label = labels[match.text].upper()
            # The label goes on the first character of the match in view
            first = max(match.start, line.rows[0].start)
            end = match.start + len(match.text)
            styles[first:end] = [PLAIN] * (end - first)
            chars[first : first + len(label)] = label
            styles[first : first + len(label)] = [LABEL] * len(label)
        for row in line.rows:
            # A space hung past the edge would wrap the row onto the next row of the popup. No
            # match holds a space, and a space at the end of a row shows nothing, so the row is
            # drawn without the spaces at its end
            row_end = row.start + len("".join(chars[row.start : row.end]).rstrip())
            drawn = ""
            style = None
            for position in range(row.start, row_end):
                if styles[position] != style:
                    style = styles[position]
                    drawn += PLAIN + style
                drawn += chars[position]
            out.append(drawn + PLAIN)
    # The cursor is hidden, and a newline after the last line would scroll the popup up by one
    sys.stdout.write("\033[?25l" + "\n".join(out))
    sys.stdout.flush()


def read_key() -> str:
    return os.read(sys.stdin.fileno(), 1).decode(errors="replace").lower()


def run(command: list[str]) -> str:
    return subprocess.run(command, capture_output=True, text=True, check=True).stdout


if __name__ == "__main__":
    main()
