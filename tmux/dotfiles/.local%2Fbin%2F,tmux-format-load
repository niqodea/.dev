#!/bin/sh

set -eu

,get-system-load | awk '{
    # The CPU has no fourth level: a busy CPU only slows programs, while full memory or a full disk makes them fail
    if ($1 < 0.3) printf "C0"
    else if ($1 < 0.6) printf "C1"
    else if ($1 < 0.9) printf "C2"
    else printf "C3"

    printf " "

    if ($2 < 50) printf "M0"
    else if ($2 < 70) printf "M1"
    else if ($2 < 80) printf "M2"
    else if ($2 < 90) printf "M3"
    else printf "#[reverse]M4#[noreverse]"

    printf " "

    if ($3 < 70) printf "D0"
    else if ($3 < 80) printf "D1"
    else if ($3 < 90) printf "D2"
    else if ($3 < 95) printf "D3"
    else printf "#[reverse]D4#[noreverse]"

    printf " "

    if ($4 == "-") printf "G-"
    else if ($4 == "?") printf "G?"
    # A busy GPU slows programs like a busy CPU, and full GPU memory makes them fail like full memory, so each takes those thresholds
    else if ($5 >= 90) printf "#[reverse]G4#[noreverse]"
    else if ($4 >= 90 || $5 >= 80) printf "G3"
    else if ($4 >= 60 || $5 >= 70) printf "G2"
    # A process that waits with a model loaded holds GPU memory, so G0 needs no process on the GPU
    else if ($4 > 0 || $6 > 0) printf "G1"
    else printf "G0"
}'
