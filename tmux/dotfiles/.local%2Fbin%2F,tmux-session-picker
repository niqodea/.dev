#!/bin/sh

set -eu

current=$(tmux display-message -p '#{session_name}')

# Only ls sorts files by time, and splitting its output into lines is safe because no project name contains a newline
# shellcheck disable=SC2012
projects=$(ls -t "$HOME"/*/"$DOTDEV_ATDIR"/tmux-session-visit | sed "s|^$HOME/||; s|/.*||")

choices=$(printf '%s\n' "$projects" | grep -Fxv -e "$current")

selected=$(printf '%s\n' "$choices" | fzf --prompt='project > ' --border=rounded --reverse --no-sort)

,tmux-open-session "$selected"
