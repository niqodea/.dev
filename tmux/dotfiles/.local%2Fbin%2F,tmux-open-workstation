#!/bin/sh

set -eu

# Wraps a word in single quotes, so a shell reads it back as it is
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

session=$(tmux display-message -p '#{session_name}')
session_path=$(tmux display-message -p '#{session_path}')

# A session has at most one workstation pane, even when two runs start at once
tmux wait-for -L "workstation-$session"
trap 'tmux wait-for -U "workstation-$session"' EXIT

existing_pane=$(tmux list-panes -s -t "=$session" -F '#{pane_id} #{@pane_type}' | awk '$2 == "workstation" {print $1}')

if [ -n "$existing_pane" ]; then
    tmux select-window -t "$existing_pane"
    tmux select-pane -t "$existing_pane"
    exit
fi

workstation_path="$session_path/$DOTDEV_ATDIR/workstation"
workstation=$(head -n 1 "$workstation_path" 2> /dev/null || true)
if [ -z "$workstation" ]; then
    tmux display-message -l "No workstation in $workstation_path"
    exit
fi

set -- -t # The remote command is interactive, so it needs a terminal
# A keepalive every minute stops an idle connection from being dropped
set -- "$@" -o ServerAliveInterval=60 -o ServerAliveCountMax=3

# ssh runs the command in a shell that has not read ~/.profile, so PATH lacks ~/.local/bin
if [ "$session" = '~' ]; then
    # The home session belongs to no project, so it has no ports to forward
    remote_command="source ~/.profile && ,tmux-open-session '~'"
else
    port_range=$(DOTDEV_PROJECT="$session" ,get-project-port-range)
    for port in $(seq "${port_range% *}" "${port_range#* }"); do
        set -- "$@" -L "0.0.0.0:$port:localhost:$port"
    done

    # The project is created on the workstation the way ,tmux-new-project creates it here
    project_path="\"\$HOME\"/$(quote "$session")/\"\$DOTDEV_ATDIR\""
    remote_command="source ~/.profile && if [ ! -d $project_path/project ]; then mkdir -p $project_path/project && touch $project_path/tmux-session-visit; fi && ,tmux-open-session $(quote "$session")"
fi

ssh_command='ssh'
for arg in "$@" "$workstation" "$remote_command"; do
    ssh_command="$ssh_command $(quote "$arg")"
done

# ssh is the pane's process, so the pane goes away when the connection ends
# A failed connection waits for Enter, so its error stays on screen
new_pane=$(tmux split-window -h -P -F '#{pane_id}' -c '#{session_path}' "$ssh_command || { echo 'Press Enter to close'; read -r _; }")
tmux set-option -p -t "$new_pane" @pane_type workstation
tmux set-option -p -t "$new_pane" @ssh_workstation "$workstation"
