#!/bin/sh

set -eu

for pane_id in $(tmux list-panes -s -F '#{pane_id}'); do
    pane_type="$(tmux show-options -pv -t "$pane_id" @pane_type)"
    case "$pane_type" in
        zsh)
            ;;
        claude)
            # Claude is only ever closed from Claude itself
            tmux display-message -l "Pane $pane_id runs Claude, quit it from Claude"
            exit
            ;;
        workstation)
            # The workstation keeps its session when the connection ends
            continue
            ;;
        *)
            tmux display-message -l "Pane $pane_id has unknown type: $pane_type"
            exit
            ;;
    esac

    status="$(tmux show-options -pv -t "$pane_id" @status)"
    if [ "$status" != 'idle' ]; then
        tmux display-message -l "Pane $pane_id is not idle"
        exit
    fi
done

tmux kill-session
