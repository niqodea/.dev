#!/bin/sh

set -eu

if [ -d "$HOME/$1/$DOTDEV_ATDIR/project" ]; then
    tmux display-message -l "Project $1 already exists, open it from M-/"
    exit
fi

mkdir -p "$HOME/$1/$DOTDEV_ATDIR/project"
# Making a project is its first visit, so M-/ lists every project from the start
touch "$HOME/$1/$DOTDEV_ATDIR/tmux-session-visit"
,tmux-open-session "$1"
