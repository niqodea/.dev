#!/bin/sh

set -eu

pane_type="$(tmux show-options -pv @pane_type)"
case "$pane_type" in
    zsh)
        ;;
    claude)
        # Claude is only ever closed from Claude itself
        tmux display-message "Pane runs Claude, quit it from Claude"
        exit
        ;;
    *)
        tmux display-message "Unknown pane type: $pane_type"
        exit
        ;;
esac

status="$(tmux show-options -pv @status)"

if [ "$status" != 'idle' ]; then
    # Prefix pane id with % to escape the leading % character
    tmux display-message "Pane is not idle"
    exit
fi

tmux kill-pane
