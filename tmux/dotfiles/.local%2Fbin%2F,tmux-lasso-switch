#!/bin/sh

set -eu

index="$1"

tracker_file="$HOME/.tmux-lasso-tracker"

if [ ! -f "$tracker_file" ]; then
    tmux display-message -l "No tracker file found at $tracker_file"
    exit
fi

session="$(sed -n "${index}p" "$tracker_file")"

if [ -z "$session" ]; then
    tmux display-message -l "No session found at index $index"
    exit
fi

# run-shell drops stderr, so the reason the session did not open is shown as a message
if ! error=$(,tmux-open-session "$session" 2>&1); then
    tmux display-message -l "$error"
fi
