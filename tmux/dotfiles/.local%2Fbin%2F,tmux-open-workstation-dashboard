#!/bin/sh

set -eu

# Opens the workstation's dashboard in a popup, only once there is a connection for it to show, so no popup flashes up and away

# Wraps a word in single quotes, so a shell reads it back as it is
quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# The current pane is a workstation pane, and its option holds the workstation it connected to, which the host file may no longer name
workstation=$(tmux display-message -p '#{@ssh_workstation}')
socket="$(tmux display-message -p '#{session_path}')/$DOTDEV_ATDIR/workstation/ssh"

# The workstation pane's connection, which the dashboard's actions ride, so they need no login
# ssh ends the line it prints with a carriage return
master_pid=$(ssh -S "$socket" -O check "$workstation" 2>&1 | sed -n 's/^Master running (pid=\([0-9]*\)).*/\1/p')
if [ -z "$master_pid" ]; then
    tmux display-message "$workstation is not connected"
    exit
fi

tmux display-popup -E ",tmux-workstation-dashboard $(quote "$workstation") $(quote "$socket") $master_pid"
