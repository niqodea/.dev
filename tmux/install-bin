#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"
backup_path="$1"
os="$2"

case "$os" in
    debian)
        ,install-package autoconf automake bison make pkg-config libevent-dev libncurses-dev
        ;;
    macos)
        # On macOS, tmux takes character widths from utf8proc, and allocates memory with jemalloc to avoid a suspected bug in calloc
        # Ref: https://github.com/tmux/tmux/issues/5385
        ,install-package autoconf automake pkgconf libevent ncurses utf8proc jemalloc
        # Homebrew keeps its ncurses out of pkg-config's search path, since macOS has an older one
        PKG_CONFIG_PATH="$(,get-package-prefix)/opt/ncurses/lib/pkgconfig"
        export PKG_CONFIG_PATH
        ;;
    *)
        >&2 echo "Unsupported system: $os"
        exit 1
        ;;
esac

# Built from our fork, which adds OSC 2029: a program marks a line with it, and tmux wraps that line at spaces instead of at the pane's edge, also when the pane resizes
# No release of tmux has it
source_path="$root/submodules/tmux"
version="$(sed -n 's/^AC_INIT(\[tmux\], *\(.*\))$/\1/p' "$source_path/configure.ac")"
tmux_path="$HOME/.local/opt/tmux-$version"

# autogen.sh and configure work in the folder they run in
(
    cd "$source_path"
    sh autogen.sh
    ./configure --prefix="$tmux_path"
)
make -C "$source_path"
make -C "$source_path" install
,link-in-local-bin "$backup_path" "$tmux_path/bin/tmux" tmux
