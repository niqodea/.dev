[submodule "git/bin-submodules/git"]
	path = git/bin-submodules/git
	url = https://github.com/git/git.git
[submodule "nvim/bin-submodules/neovim"]
	path = nvim/bin-submodules/neovim
	url = https://github.com/neovim/neovim.git
[submodule "nvim/bin-submodules/nvim-treesitter"]
	path = nvim/bin-submodules/nvim-treesitter
	url = https://github.com/nvim-treesitter/nvim-treesitter.git
[submodule "nvim/dotfiles-submodules/aerial.nvim"]
	path = nvim/dotfiles-submodules/aerial.nvim
	url = https://github.com/stevearc/aerial.nvim.git
[submodule "nvim/dotfiles-submodules/cmp-nvim-lsp"]
	path = nvim/dotfiles-submodules/cmp-nvim-lsp
	url = https://github.com/hrsh7th/cmp-nvim-lsp.git
[submodule "nvim/dotfiles-submodules/fzf-lua"]
	path = nvim/dotfiles-submodules/fzf-lua
	url = https://github.com/ibhagwan/fzf-lua.git
[submodule "nvim/dotfiles-submodules/gitsigns.nvim"]
	path = nvim/dotfiles-submodules/gitsigns.nvim
	url = https://github.com/lewis6991/gitsigns.nvim.git
[submodule "nvim/dotfiles-submodules/lasso.nvim"]
	path = nvim/dotfiles-submodules/lasso.nvim
	url = https://github.com/niqodea/lasso.nvim.git
[submodule "nvim/dotfiles-submodules/nvim-cmp"]
	path = nvim/dotfiles-submodules/nvim-cmp
	url = https://github.com/hrsh7th/nvim-cmp.git
[submodule "nvim/dotfiles-submodules/nvim-snippy"]
	path = nvim/dotfiles-submodules/nvim-snippy
	url = https://github.com/dcampos/nvim-snippy.git
[submodule "python/bin-submodules/ropify"]
	path = python/bin-submodules/ropify
	url = https://github.com/niqodea/ropify
[submodule "python/bin-submodules/tree-sitter-python"]
	path = python/bin-submodules/tree-sitter-python
	url = https://github.com/tree-sitter/tree-sitter-python.git
    ignore = dirty
[submodule "tmux/bin-submodules/tmux"]
	path = tmux/bin-submodules/tmux
	url = https://github.com/tmux/tmux.git
[submodule "tmux/dotfiles-submodules/tmux-matryoshka"]
	path = tmux/dotfiles-submodules/tmux-matryoshka
	url = https://github.com/niqodea/tmux-matryoshka
[submodule "utils/bin-submodules/breadcrumbs"]
	path = utils/bin-submodules/breadcrumbs
	url = https://github.com/niqodea/breadcrumbs.git
[submodule "utils/bin-submodules/ffmpeg"]
	path = utils/bin-submodules/ffmpeg
	url = https://git.ffmpeg.org/ffmpeg.git
[submodule ".foundation/bin-submodules/hburger"]
	path = .foundation/bin-submodules/hburger
	url = https://github.com/niqodea/hburger.git
[submodule "utils/bin-submodules/password-store"]
	path = utils/bin-submodules/password-store
	url = https://git.zx2c4.com/password-store
[submodule "zsh/bin-submodules/zsh"]
	path = zsh/bin-submodules/zsh
	url = https://github.com/zsh-users/zsh.git
[submodule "zsh/dotfiles-submodules/fzf"]
	path = zsh/dotfiles-submodules/fzf
	url = https://github.com/junegunn/fzf.git
