[submodule "nvim/dotfiles-submodules/fzf-lua"]
	path = nvim/dotfiles-submodules/fzf-lua
	url = https://github.com/ibhagwan/fzf-lua.git
[submodule "nvim/dotfiles-submodules/lasso.nvim"]
	path = nvim/dotfiles-submodules/lasso.nvim
	url = https://github.com/niqodea/lasso.nvim.git
[submodule "python/bin-submodules/ropify"]
	path = python/bin-submodules/ropify
	url = https://github.com/niqodea/ropify
[submodule "python/bin-submodules/tree-sitter-python"]
	path = python/bin-submodules/tree-sitter-python
	url = https://github.com/tree-sitter/tree-sitter-python.git
    ignore = dirty
[submodule "tmux/dotfiles-submodules/tmux-matryoshka"]
	path = tmux/dotfiles-submodules/tmux-matryoshka
	url = https://github.com/niqodea/tmux-matryoshka
[submodule "utils/bin-submodules/breadcrumbs"]
	path = utils/bin-submodules/breadcrumbs
	url = https://github.com/niqodea/breadcrumbs.git
[submodule ".foundation/bin-submodules/hburger"]
	path = .foundation/bin-submodules/hburger
	url = https://github.com/niqodea/hburger.git
[submodule "utils/bin-submodules/lm"]
	path = utils/bin-submodules/lm
	url = https://github.com/niqodea/lm.git
