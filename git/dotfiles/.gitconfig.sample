[user]
    name = Nicola De Angeli
    # email = "someemail@somedomain.com"
[core]
    excludesfile = ~/.gitignore  # Ignored in every repository
[merge]
    conflictstyle = diff3  # Conflicts also show the common ancestor
[pull]
    rebase = true  # Pulling rebases local commits instead of adding a merge commit
[push]
    autoSetupRemote = true  # The first push creates a remote branch of the same name
