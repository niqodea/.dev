#!/bin/sh

set -eu

# A pipeline exits with the status of its last command, so a failing git ls-files below would go unnoticed
git rev-parse --git-dir > /dev/null

# $path belongs to the inner sh below, so the single quotes keep it from expanding here
# shellcheck disable=SC2016
# Without --deduplicate, a file with a merge conflict is listed once per version git keeps of it
git ls-files -z --cached --others --exclude-standard --deduplicate |
    # Drop the files that are tracked but deleted from the working tree, which ls would fail on
    xargs --null sh -c 'for path; do if [ -e "$path" ] || [ -h "$path" ]; then printf "%s\0" "$path"; fi; done' sh |
    # Past about 1 MB of paths, xargs splits them across several ls, and each sorts only its own share
    # Without -1, ls prints columns when it writes to a terminal
    xargs --null --no-run-if-empty ls -1td --
