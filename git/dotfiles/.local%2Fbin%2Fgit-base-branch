#!/bin/sh

set -eu

branch="$(git branch --show-current)"
# git does not record which branch a branch started from, so each branch keeps it in a setting of its own
key="branch.$branch.dotdev-base"
# Stands in on a detached HEAD, and on a branch with no base of its own
default_base_branch='origin/HEAD'

# Like git config, it reads the base without an argument and sets it with one
case "$#" in
    0)
        if [ -z "$branch" ]; then
            echo "$default_base_branch"
            exit
        fi
        git config --default "$default_base_branch" --get "$key"
        ;;
    1)
        if [ -z "$branch" ]; then
            >&2 echo 'Error: HEAD is on no branch, so there is no base to set'
            exit 1
        fi
        # A base that names nothing would only fail later, at the first review
        if ! git rev-parse --verify --quiet "$1^{commit}" > /dev/null; then
            >&2 echo "Error: $1 names no commit"
            exit 1
        fi
        git config "$key" "$1"
        ;;
    *)
        >&2 echo 'Usage: git base-branch [<branch>]'
        exit 1
        ;;
esac
