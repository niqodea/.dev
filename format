#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"

# Our scripts have no extension, so the shebang is what marks one
git -C "$root" grep --files-with-matches '^#!/bin/sh$' | sed "s|^|$root/|" | xargs shfmt --write

# The profile and the files it loads from profile.d are shell, and only their location says so
git -C "$root" ls-files '.foundation/profile' '.foundation/profile.d/*' '*/dotfiles/.profile.d%2F*' | sed "s|^|$root/|" | xargs shfmt --write

# zsh files are marked by their name
# shfmt cannot parse the always blocks in the fzf completion, which is kept as fzf wrote it
git -C "$root" grep --files-with-matches '' -- '*.zsh' '*.zshrc' '*.zsh.sample' ':!zsh/dotfiles/.zsh-modules/core/fzf-completion.zsh' | sed "s|^|$root/|" | xargs shfmt --write
