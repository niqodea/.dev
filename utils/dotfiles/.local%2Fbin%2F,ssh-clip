#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    >&2 echo "Error: no command specified"
    exit 1
fi

command="$1"
shift

if [ "$command" = 'connect' ]; then
    destination="$1"
    SSH_DESTINATION="$destination" ssh "$destination"
# put and yank run from inside a connection, through <Enter>~C!, which needs PermitLocalCommand and EnableEscapeCommandline
# Each runs in the background, since the inner ssh needs the control master, which stays busy until the escape command returns
# So the copy can finish after the prompt is back
elif [ "$command" = 'put' ]; then
    (,clipboard read | ssh "$SSH_DESTINATION" 'source .profile; ,clipboard write') &
elif [ "$command" = 'yank' ]; then
    (ssh "$SSH_DESTINATION" 'source .profile; ,clipboard read' | ,clipboard write) &
else
    >&2 echo "Error: unknown command $command"
    exit 1
fi
