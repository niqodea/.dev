#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"
backup_path="$1"
os="$2"

,install-package pass ffmpeg imagemagick
pass_path="$(,get-package-path pass)"
,link-in-local-bin "$backup_path" "$pass_path" pass
ffmpeg_path="$(,get-package-path ffmpeg)"
,link-in-local-bin "$backup_path" "$ffmpeg_path" ffmpeg
ffprobe_path="$(,get-package-path ffprobe)"
,link-in-local-bin "$backup_path" "$ffprobe_path" ffprobe
magick_path="$(,get-package-path magick)"
,link-in-local-bin "$backup_path" "$magick_path" magick

# Podman runs containers without a daemon, so installing or upgrading it never stops a running container
case "$os" in
    debian)
        # Without root, Podman maps user IDs with uidmap and reaches the network through passt, both only recommended by Podman's package
        ,install-package podman uidmap passt
        ;;
    macos)
        ,install-package podman
        ;;
    *)
        >&2 echo "Unsupported system: $os"
        exit 1
        ;;
esac
podman_path="$(,get-package-path podman)"
,link-in-local-bin "$backup_path" "$podman_path" podman

# Only macOS runs the macOS virtual machines that Tart makes
if [ "$os" = macos ]; then
    tart_version='2.41.1'
    # Changes with the version above, and comes from the release's own digest on GitHub
    tart_sha256='e680a734febccfce7d4e910c1f7f13fc3b00f19a181c945e2d746de3214c32c2'
    # Downloaded, since Homebrew's Tart needs softnet, which only runs on macOS 26 and later, though Tart runs on macOS 13
    tart_path="$(,download-release "https://github.com/openai/tart/releases/download/$tart_version/tart.tar.gz" "$tart_sha256" tart "$tart_version")"
    ,link-in-local-bin "$backup_path" "$tart_path/tart.app/Contents/MacOS/tart" tart
fi

breadcrumbs_path="$root/submodules/breadcrumbs"
cargo build --manifest-path="$breadcrumbs_path/Cargo.toml" --release
,copy-in-home "$backup_path" "$breadcrumbs_path/target/release/breadcrumbs" .local/bin/breadcrumbs

lm_path="$root/submodules/lm"
,copy-in-home "$backup_path" "$lm_path/lm" .local/bin/lm
