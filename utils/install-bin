#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"
backup_path="$1"
os="$2"

,install-package pass ffmpeg
pass_path="$(,get-package-path pass)"
,link-in-local-bin "$backup_path" "$pass_path" pass
ffmpeg_path="$(,get-package-path ffmpeg)"
,link-in-local-bin "$backup_path" "$ffmpeg_path" ffmpeg
ffprobe_path="$(,get-package-path ffprobe)"
,link-in-local-bin "$backup_path" "$ffprobe_path" ffprobe

"$root/install-docker/$os" "$backup_path"
docker_path="$(,get-package-path docker)"
,link-in-local-bin "$backup_path" "$docker_path" docker

breadcrumbs_path="$root/bin-submodules/breadcrumbs"
git -C "$root" submodule update --init "$breadcrumbs_path"
cargo build --manifest-path="$breadcrumbs_path/Cargo.toml" --release
,copy-in-home "$backup_path" "$breadcrumbs_path/target/release/breadcrumbs" .local/bin/breadcrumbs
