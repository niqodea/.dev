#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"

# Run with the environment a new terminal will have, which a fresh machine does not have yet
. "$root/.foundation/profile"

if [ "$#" -eq 0 ]; then
    modules=$(find "$root/"* -maxdepth 0 -type d -exec basename {} \;)
else
    modules="$*"
fi

backup_path="$HOME/$DOTDEV_ATDIR/backups/$(date '+%Y_%m_%d-%H_%M_%S')"

# The body runs in a subshell, so each recursive call keeps its own variables
install_dotfile() (
    source_path="$1"
    target_relpath="$2"
    mkdir -p "$(dirname "$HOME/$target_relpath")" # rsync needs the parent folder to exist

    if [ -d "$source_path" ]; then
        # rsync takes a link through a breadcrumb for a link inside the folder and would copy it as is,
        # so each of them is installed on its own from where it leads
        breadcrumb_links="$(find "$source_path" -type l \( -lname '..root/*' -o -lname '..module/*' \) | sed "s|^$source_path||")"

        printf '%s\n' "$breadcrumb_links" | rsync --archive --checksum --copy-unsafe-links --delete \
            --exclude='..root' --exclude='..module' --exclude-from=- \
            --backup --backup-dir="$backup_path/$target_relpath" \
            "$source_path/" "$HOME/$target_relpath" # The trailing slash copies the folder's contents, not the folder itself

        printf '%s\n' "$breadcrumb_links" | while IFS= read -r link_relpath; do
            if [ -n "$link_relpath" ]; then
                install_dotfile "$(realpath "$source_path$link_relpath")" "$target_relpath$link_relpath"
            fi
        done
    else
        backup_dir="$backup_path/$(dirname "$target_relpath")"

        if [ "${backup_dir#"${backup_dir%/.}"}" = "/." ]; then
            # rsync fails on a backup folder that ends in /.
            backup_dir="${backup_dir%/.}"
        fi

        rsync --archive --checksum --copy-unsafe-links \
            --backup --backup-dir="$backup_dir" \
            "$source_path" "$HOME/$target_relpath"
    fi
)

for module in $modules; do
    module_path="$root/$module"

    if [ ! -d "$module_path" ]; then
        >&2 echo "Module $module not found"
        continue
    fi

    echo "Installing dotfiles for module $module"
    source_dotfiles_path="$module_path/dotfiles"
    dotfiles_submodules_path="$module_path/dotfiles-submodules"

    if [ -d "$dotfiles_submodules_path" ]; then
        echo "Pulling Git submodules for dotfiles of module $module"
        for submodule_path in "$dotfiles_submodules_path/"*; do
            submodule_canon_path="$(readlink -f "$submodule_path")" # git takes a submodule by its real path, not through a symlink
            git -C "$root" submodule update --init "$submodule_canon_path"
        done
    fi

    for source_dotfile_path in "$source_dotfiles_path/."[!.]*; do
        install_dotfile "$source_dotfile_path" "$(basename "$source_dotfile_path" | sed "s/%2F/\//g")"
    done

    echo "Successfully installed dotfiles for module $module"
done

if [ -e "$backup_path" ]; then
    echo "Backed up overwritten dotfiles in $backup_path"
else
    echo 'All dotfiles already up-to-date, no files overwritten'
fi
