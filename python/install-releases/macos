#!/bin/sh

set -eu

backup_path="$1"

uv_version='0.13.1'

# Each download's sha256 changes with the version above, and comes from the release's own digest on GitHub
case "$(uname -m)" in
    'arm64')
        uv_target='aarch64-apple-darwin'
        uv_sha256='cfe454573412ff7380d15fc7dae5997ab53ffce72fce0a78e91ddbc84001acd2'
        ;;
    'x86_64')
        uv_target='x86_64-apple-darwin'
        uv_sha256='bb7b805bdcf3d0bc8c74ceb94569e6b3e8aa35bd492acdbb9d46bf46d9d4ff6b'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# Downloaded as on Debian, which does not package it
uv_path="$(,download-release "https://github.com/astral-sh/uv/releases/download/$uv_version/uv-$uv_target.tar.gz" "$uv_sha256" uv "$uv_version")"
,link-in-local-bin "$backup_path" "$uv_path/uv" uv
,link-in-local-bin "$backup_path" "$uv_path/uvx" uvx
