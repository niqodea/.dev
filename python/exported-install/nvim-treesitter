#!/bin/sh

set -eu

# Resolved, as git takes a submodule by its real path, not through a symlink
root="$(realpath "$(dirname "$(realpath "$0")")/..module")"
backup_path="$1"

grammar_path="$root/submodules/tree-sitter-python"
# Fetched here, since installing a module fetches only that module's submodules, and this script also runs for other modules
git -C "$root" submodule update --init --depth 1 "$grammar_path"
grammar_commit="$(git -C "$grammar_path" rev-parse HEAD)"

# Two builds of the same grammar differ byte for byte, so each grammar commit is built once and that build is copied
build_path="$HOME/.local/opt/tree-sitter-python-$grammar_commit"
if [ ! -e "$build_path" ]; then
    mkdir -p "$HOME/.local/opt"
    tmp="$(mktemp -d "$HOME/.local/opt/.tree-sitter-python.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    tree-sitter build "$grammar_path" -o "$tmp/python.so"
    mv "$tmp" "$build_path"
fi

site_path="$HOME/.local/share/nvim/site"
mkdir -p "$site_path/parser" "$site_path/queries/python"
rsync --archive --checksum --backup --backup-dir="$backup_path/.local/share/nvim/site/parser" "$build_path/python.so" "$site_path/parser/python.so"
rsync --archive --checksum --backup --backup-dir="$backup_path/.local/share/nvim/site/queries/python" "$grammar_path/queries/highlights.scm" "$site_path/queries/python/highlights.scm"
