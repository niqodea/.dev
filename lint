#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"

# Our scripts have no extension, so the shebang is what marks one
# git grep reads only regular tracked files, so symlinks and submodules are left out
git -C "$root" grep --files-with-matches '^#!/bin/sh$' | sed "s|^|$root/|" | xargs shellcheck
git -C "$root" grep --files-with-matches '^#!/bin/sh$' | sed "s|^|$root/|" | xargs shfmt --diff

# The profile and the files it loads from profile.d are shell, and only their location says so
git -C "$root" ls-files '.foundation/profile' '.foundation/profile.d/*' '*/dotfiles/.profile.d%2F*' | sed "s|^|$root/|" | xargs shellcheck --shell=sh
git -C "$root" ls-files '.foundation/profile' '.foundation/profile.d/*' '*/dotfiles/.profile.d%2F*' | sed "s|^|$root/|" | xargs shfmt --diff

# zsh files are marked by their name, and ShellCheck does not read zsh, so only syntax and format are checked
# zsh checks one file per run, and xargs has no long form of -n on macOS
git -C "$root" grep --files-with-matches '' -- '*.zsh' '*.zshrc' '*.zshenv' '*.zsh.sample' | sed "s|^|$root/|" | xargs -n 1 zsh --no-exec
# shfmt cannot parse the always blocks in the fzf completion, which is kept as fzf wrote it
git -C "$root" grep --files-with-matches '' -- '*.zsh' '*.zshrc' '*.zshenv' '*.zsh.sample' ':!zsh/dotfiles/.zsh-modules/core/fzf-completion.zsh' | sed "s|^|$root/|" | xargs shfmt --diff

# An empty pattern matches every file with a line in it, which here means every regular tracked Lua file
# --codes names each warning's rule, which an inline ignore has to name too
# The plain formatter prints only the warnings, so a clean run prints nothing, like every other check here
git -C "$root" grep --files-with-matches '' -- '*.lua' | sed "s|^|$root/|" | xargs luacheck --config "$root/.luacheckrc" --formatter plain --codes
git -C "$root" grep --files-with-matches '' -- '*.lua' | sed "s|^|$root/|" | xargs stylua --config-path "$root/.stylua.toml" --check

# -n parses the files without running their commands, on a server of its own, so no tmux session sees them
git -C "$root" grep --files-with-matches '' -- '*.tmux.conf' | sed "s|^|$root/|" | xargs tmux -L lint -f /dev/null start-server ';' source-file -n

# jq does not name the file a parse error is in, so each file is checked on its own
git -C "$root" grep --files-with-matches '' -- '*.json' | sed "s|^|$root/|" | while IFS= read -r path; do
    if ! jq empty "$path"; then
        >&2 echo "$path: not valid JSON"
        exit 1
    fi
done

git config --file "$root/git/dotfiles/.gitconfig.sample" --list > /dev/null
# -G reads the config and prints it for a host instead of connecting, and -T keeps it from warning when no terminal is attached
ssh -T -G -F "$root/utils/dotfiles/.ssh%2Fconfig.sample" lint > /dev/null
