#!/bin/sh

set -eu

backup_path="$1"

neovim_version='v0.12.6'
tree_sitter_version='v0.25.10'

# Each download's sha256 changes with the versions above, and comes from the release's own digest on GitHub
case "$(uname -m)" in
    'aarch64')
        neovim_arch='arm64'
        tree_sitter_arch='arm64'
        neovim_sha256='8f1f64a0bdb97247034038c3823c6cbad5bdf9ecd5751b85494b71c3ee04c815'
        tree_sitter_sha256='07fbff8ae0eeb0d3e496e14fc1a30dcc730cc2c97d70e601e5357f2e51958af5'
        ;;
    'x86_64')
        neovim_arch='x86_64'
        tree_sitter_arch='x64'
        neovim_sha256='474430d53e6264f6d6dd18db42d6dc9df3a1b56ca9e88a325bbf860e1a811d87'
        tree_sitter_sha256='8283ddba69253c698f6e987ba0e2f9285e079c8db4d36ebe1394b5bb3a0ebdfd'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# Debian 13 has nvim 0.10, which is too old for this setup
neovim_path="$(,download-release "https://github.com/neovim/neovim/releases/download/$neovim_version/nvim-linux-$neovim_arch.tar.gz" "$neovim_sha256" nvim "$neovim_version")"
,link-in-local-bin "$backup_path" "$neovim_path/bin/nvim" nvim

# Debian 13 has tree-sitter 0.22, which is too old for this setup
tree_sitter_path="$(,download-release "https://github.com/tree-sitter/tree-sitter/releases/download/$tree_sitter_version/tree-sitter-linux-$tree_sitter_arch.gz" "$tree_sitter_sha256" tree-sitter "$tree_sitter_version")"
,link-in-local-bin "$backup_path" "$tree_sitter_path/tree-sitter" tree-sitter
