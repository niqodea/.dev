#!/bin/sh

set -eu

backup_path="$1"

neovim_version='v0.12.6'
tree_sitter_version='v0.25.10'

# Each download's sha256 changes with the versions above, and comes from the release's own digest on GitHub
case "$(uname -m)" in
    'arm64')
        neovim_arch='arm64'
        tree_sitter_arch='arm64'
        neovim_sha256='1dbd148222b051ba6c307c4d17a318ed083df018a4f6a5a0ce46955ffc9ab87b'
        tree_sitter_sha256='a6295d469669f6e901b6029ae6c129bd094df582d278c237fada413505cb9c42'
        ;;
    'x86_64')
        neovim_arch='x86_64'
        tree_sitter_arch='x64'
        neovim_sha256='481424f1dbc85f637d57e47d27d042aa9c883e5a4fe9ee64fc4ee9573b221998'
        tree_sitter_sha256='c7a962bdc850dccb184afdb73853754767304d725b545362352d1838c9a18d7e'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# Downloaded as on Debian, where the package is too old
neovim_path="$(,download-release "https://github.com/neovim/neovim/releases/download/$neovim_version/nvim-macos-$neovim_arch.tar.gz" "$neovim_sha256" nvim "$neovim_version")"
,link-in-local-bin "$backup_path" "$neovim_path/bin/nvim" nvim

# Downloaded as on Debian, which does not package it
tree_sitter_path="$(,download-release "https://github.com/tree-sitter/tree-sitter/releases/download/$tree_sitter_version/tree-sitter-macos-$tree_sitter_arch.gz" "$tree_sitter_sha256" tree-sitter "$tree_sitter_version")"
,link-in-local-bin "$backup_path" "$tree_sitter_path/tree-sitter" tree-sitter
