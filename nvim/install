#!/bin/sh
set -eux

root="$(dirname "$(realpath "$0")")"
install_path="$1"
platform="$2"

nvim_version='v0.12.3'
treesitter_version='v0.26.9'

case "$platform" in
    'debian')
        os='linux'
        ;;
    'macos')
        os='macos'
        ;;
    *)
        >&2 echo "Unsupported platform: '$platform'"
        exit 1
        ;;
esac

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

nvim_tar_file="nvim-$os-x86_64.tar.gz"
nvim_tar_url="https://github.com/neovim/neovim/releases/download/$nvim_version/$nvim_tar_file"
curl -L -o "$tmp/$nvim_tar_file" "$nvim_tar_url"
tar -xf "$tmp/$nvim_tar_file" -C "$install_path" --strip-components=1

treesitter_gz_file="tree-sitter-$os-x64.gz"
treesitter_gz_url="https://github.com/tree-sitter/tree-sitter/releases/download/$treesitter_version/$treesitter_gz_file"
treesitter_bin_path="$install_path/bin/tree-sitter"
curl -L -o "$tmp/$treesitter_gz_file" "$treesitter_gz_url"
gunzip --to-stdout "$tmp/$treesitter_gz_file" > "$treesitter_bin_path"
chmod +x "$treesitter_bin_path"

"$root/install.d/python-treesitter" "$HOME/.local/share/nvim/site"
