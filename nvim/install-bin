#!/bin/sh

set -eu

backup_path="$1"
os="$2"

neovim_version='v0.12.6'

# Each download's sha256 changes with the version above, and comes from the release's own digest on GitHub
case "$os-$(uname -m)" in
    'macos-arm64')
        neovim_platform='macos-arm64'
        neovim_sha256='1dbd148222b051ba6c307c4d17a318ed083df018a4f6a5a0ce46955ffc9ab87b'
        ;;
    'macos-x86_64')
        neovim_platform='macos-x86_64'
        neovim_sha256='481424f1dbc85f637d57e47d27d042aa9c883e5a4fe9ee64fc4ee9573b221998'
        ;;
    'debian-aarch64')
        neovim_platform='linux-arm64'
        neovim_sha256='8f1f64a0bdb97247034038c3823c6cbad5bdf9ecd5751b85494b71c3ee04c815'
        ;;
    'debian-x86_64')
        neovim_platform='linux-x86_64'
        neovim_sha256='474430d53e6264f6d6dd18db42d6dc9df3a1b56ca9e88a325bbf860e1a811d87'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# Downloaded on every system, since Debian 13 has nvim 0.10, which is too old for this setup
neovim_path="$(,download-release "https://github.com/neovim/neovim/releases/download/$neovim_version/nvim-$neovim_platform.tar.gz" "$neovim_sha256" nvim "$neovim_version")"
,link-in-local-bin "$backup_path" "$neovim_path/bin/nvim" nvim

grammar_version='v0.25.0'
# Changes with the version above, and comes from the release's own digest on GitHub
grammar_sha256='7bce887eb2f33e94bf74a69645cf5138d4096720e54fd3269a6124c06b93c584'
grammar_path="$(,download-release "https://github.com/tree-sitter/tree-sitter-python/releases/download/$grammar_version/tree-sitter-python.tar.gz" "$grammar_sha256" tree-sitter-python "$grammar_version")"

# nvim's releases load only native parsers, and the grammar's releases ship none, so the parser is built from its sources
# Two builds of the same sources differ byte for byte, so each version is built once and that build is copied
parser_path="$HOME/.local/opt/tree-sitter-python-parser-$grammar_version"
if [ ! -e "$parser_path" ]; then
    tmp="$(mktemp -d "$HOME/.local/opt/.tree-sitter-python-parser.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    cc -shared -fPIC -O2 -I "$grammar_path/src" "$grammar_path/src/parser.c" "$grammar_path/src/scanner.c" -o "$tmp/python.so"
    mv "$tmp" "$parser_path"
fi

site_path="$HOME/.local/share/nvim/site"
mkdir -p "$site_path/parser" "$site_path/queries/python"
rsync --archive --checksum --backup --backup-dir="$backup_path/.local/share/nvim/site/parser" "$parser_path/python.so" "$site_path/parser/python.so"
rsync --archive --checksum --backup --backup-dir="$backup_path/.local/share/nvim/site/queries/python" "$grammar_path/queries/highlights.scm" "$site_path/queries/python/highlights.scm"
