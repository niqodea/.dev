UserId = NewType("UserId", str)
ConversationId = NewType("ConversationId", str)
MessageTimestamp = NewType("MessageTimestamp", str)
UserName = NewType("UserName", str)

# SLACK_TOKEN only has read scopes, so a method outside this list would fail
# Each method needs its scope in manifest.json, and the two have to match,
# except auth.test, which needs none
type ReadMethod = Literal[
    "auth.test",
    "conversations.history",
    "conversations.info",
    "conversations.replies",
    "search.messages",
    "users.conversations",
    "users.info",
    "users.list",
]
# The write token only has chat:write
type WriteMethod = Literal["chat.postMessage"]

# Someone is waiting at the terminal, and an answer later than this is not worth
# waiting for
TIMEOUT_SECONDS = 30
# Slack recommends at most 200 items per page
# Ref: https://docs.slack.dev/apis/web-api/pagination
PAGE_SIZE = 200
# search.messages returns at most 100 matches per page, and pages by number
# Ref: https://docs.slack.dev/reference/methods/search.messages
SEARCH_PAGE_SIZE = 100
# 110 conversations.info calls took 3.4 s eight at a time, without Slack limiting
# the rate
PARALLEL_CALLS = 8
SLACKBOT_USER_ID = UserId("USLACKBOT")
# Enough for the recent part of a conversation, and few enough to leave room in
# Claude's context, which a read with neither --days nor --since gets
DEFAULT_MESSAGE_LIMIT = 50
DEFAULT_SEARCH_LIMIT = 20
# unread checks only the threads you follow with a reply in this many days.
# Ideally it would check them all, but Slack's API has no list of the threads you
# follow, so unread finds them by searching recent replies. A week of replies took
# 5 search calls and a month 28, and Slack allows search about 20 calls a minute
RECENT_REPLY_DAYS = 7
READ_TOKEN_KEYCHAIN_SERVICE = "slack-cli"
WRITE_TOKEN_KEYCHAIN_SERVICE = "slack-write-cli"
TIMESTAMP_FORMAT = "%Y-%m-%d %H:%M"
# Slack's markup for a mention, which notifies the person
# Ref: https://docs.slack.dev/messaging/formatting-message-text
MENTION_MARKUP_PATTERN = re.compile(r"<@(\w+)>")
# A mention in a message to post, with a person's name or id inside
MENTION_PATTERN = re.compile(r"<@([^>]+)>")
USER_ID_PATTERN = re.compile(r"U[A-Z0-9]{8,}")
# Continuation lines start under the text, after a timestamp and a space
CONTINUATION_INDENT = " " * len(datetime(2000, 1, 1).strftime(TIMESTAMP_FORMAT) + " ")


@dataclass(frozen=True)
class Thread:
    conversation_id: ConversationId
    timestamp: MessageTimestamp


@dataclass(frozen=True)
class Description:
    """What describe prints, as JSON, to show the person deciding:
    what the request does, and what it acts on, each value under its label.
    """

    title: str
    fields: dict[str, str]


@dataclass(frozen=True)
class ReplyPlace:
    """The thread a message replies in."""

    timestamp: MessageTimestamp
    # The thread's latest message when command read it, so the person deciding
    # sees the replies posted since, which Slack has no way to refuse a post over
    seen_timestamp: MessageTimestamp


@dataclass(frozen=True)
class PostMessage:
    """A message command asks for approval to post."""

    conversation_id: ConversationId
    # None outside a thread
    reply_place: ReplyPlace | None
    text: str


@dataclass(frozen=True)
class Window:
    """The time to read messages from, open at an end that is None."""

    oldest: datetime | None
    latest: datetime | None

    def contains(self, timestamp: MessageTimestamp) -> bool:
        at = datetime.fromtimestamp(float(timestamp))
        is_after_oldest = self.oldest is None or self.oldest <= at
        is_before_latest = self.latest is None or at < self.latest
        return is_after_oldest and is_before_latest


@dataclass(frozen=True)
class Channel:
