@dataclass(frozen=True)
class Message:
    post: Post
    # None outside a thread
    thread: ThreadStart | ThreadReply | None
    reactions: tuple[Reaction, ...]
    # Messages forwarded into this one, or linked from it and shown in full
    shared: tuple[Post, ...]


@dataclass(frozen=True)
class SearchResult:
    """A message found by search, which Slack returns without its replies or reactions."""

    conversation: Conversation
    post: Post
    # Messages forwarded into this one, or linked from it and shown in full
    shared: tuple[Post, ...]
