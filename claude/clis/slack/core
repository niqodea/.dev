@dataclass(frozen=True)
class ThreadStart:
    """A message with replies in a thread."""

    reply_count: int


@dataclass(frozen=True)
class ThreadReply:
    """A reply in a thread, which a conversation's history shows only when it
    was also sent to the conversation.
    """

