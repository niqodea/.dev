#!/usr/bin/env python3
"""Outlook CLI, for the mail and calendar of a Microsoft 365 account.

The same file is installed under three names. As command, it only reads, and
asks for approval to send mail. As describe and action, which Claude never runs,
it says what a mail asks for, and sends it.

command and describe read as one app, and action sends as another, which can
only send, see README.md. Each signs in through the browser the first time, and
keeps its refresh token in the macOS Keychain.
"""

import argparse
import getpass
import itertools
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from collections.abc import Iterator, Mapping, Sequence
from dataclasses import asdict, dataclass
from datetime import UTC, date, datetime, timedelta
from pathlib import Path
from typing import Any, Literal, NewType, NoReturn, assert_never

MessageId = NewType("MessageId", str)

# The account's organization and the two apps registered in it, see README.md
CONFIG_PATH = Path.home() / ".config/outlook-cli/config.json"
GRAPH_URL = "https://graph.microsoft.com/v1.0"
KEYCHAIN_ITEM_NOT_FOUND = 44
# A loose check that catches a name given for an address, and leaves the rest
# to Outlook
EMAIL_ADDRESS_PATTERN = re.compile(r"[^@\s]+@[^@\s]+\.[^@\s]+")
# Someone is waiting at the terminal, and an answer later than this is not worth
# waiting for
TIMEOUT_SECONDS = 30
# Graph returns at most 1000 messages per page
# Ref: https://learn.microsoft.com/en-us/graph/api/user-list-messages
PAGE_SIZE = 1000
# What parse_summary reads
SUMMARY_FIELDS = "id,receivedDateTime,from,subject,bodyPreview,isRead,hasAttachments"
TIMESTAMP_FORMAT = "%Y-%m-%d %H:%M"
# Enough for the recent part of a mailbox or channel, and few enough to leave
# room in Claude's context, which a read with neither --days nor --since gets
DEFAULT_MESSAGE_LIMIT = 50
DEFAULT_SEARCH_LIMIT = 20
BODY_INDENT = "  "

type Response = Literal[
    "none",
    "organizer",
    "tentativelyAccepted",
    "accepted",
    "declined",
    "notResponded",
]


@dataclass(frozen=True)
class App:
    """An app registered for this CLI, see README.md."""

    # The sign-in address of the organization the app is registered in
    login_url: str
    # What the sign-in calls client_id
    id: str
    # offline_access is what makes the sign-in return a refresh token
    scopes: str
    keychain_service: str
    # What a person runs in a terminal to sign in, when no refresh token works
    sign_in_command: str


@dataclass(frozen=True)
class Apps:
    read: App
    send: App


@dataclass(frozen=True)
class Description:
    """What describe prints, as JSON, to show the person deciding:
    what the request does, and what it acts on, each value under its label.
    """

    title: str
    fields: dict[str, str]


@dataclass(frozen=True)
class SendMail:
    """A new mail command asks for approval to send."""

    to: tuple[str, ...]
    cc: tuple[str, ...]
    subject: str
    body: str


@dataclass(frozen=True)
class ReplyToMail:
    """A reply to the sender of a mail command asks for approval to send."""

    message_id: MessageId
    body: str


type MailRequest = SendMail | ReplyToMail


