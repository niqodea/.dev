#!/usr/bin/env python3
"""Read-only Discord CLI.

Reads DISCORD_TOKEN, the token of a bot that is a member of one server.
"""

import argparse
import dataclasses
import itertools
import json
import os
import re
import shutil
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import zlib
