#!/bin/sh

set -eu

os="$2"

version='2.1.303'

# Each sha256 changes with the version above, and comes from the release's own manifest.json next to the binaries
case "$os-$(uname -m)" in
    'macos-arm64')
        platform='darwin-arm64'
        sha256='d2da3b003dc08b88b7230469014fe3e1dc6fe94bc8f648e89b34175d30269370'
        ;;
    'macos-x86_64')
        platform='darwin-x64'
        sha256='6c5d63b43568c5d60963d40f05b0087cb03ba44a90740d27adc505f4157806db'
        ;;
    'debian-aarch64')
        platform='linux-arm64'
        sha256='f384f49826336d4ac0484ac6ac9d8d16f64d244d186ce227cbd7cc088c03315d'
        ;;
    'debian-x86_64')
        platform='linux-x64'
        sha256='375988f457756524234695cf2d8f64ace99c5f68682e47ea24862a843c191450'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# claude.ai/install.sh has no published sha256, so this does its two steps itself: download the binary, then let it install itself
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
curl --fail --silent --show-error --location --max-time 600 --output "$tmp/claude" "https://downloads.claude.ai/claude-code-releases/$version/$platform/claude"
,check-sha256 "$sha256" "$tmp/claude"
chmod +x "$tmp/claude"
"$tmp/claude" install "$version"
