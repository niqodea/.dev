#!/bin/sh

set -eu

root="$(dirname "$(realpath "$0")")"
backup_path="$1"

cargo build --manifest-path="$root/approval/Cargo.toml" --release
,copy-in-home "$backup_path" "$root/approval/target/release/approval" .local/bin/,approval
,copy-in-home "$backup_path" "$root/approval/target/release/approval-answer" .local/bin/,approval-answer

claudio_path="$root/submodules/claudio"
cargo build --manifest-path="$claudio_path/Cargo.toml" --release
,copy-in-home "$backup_path" "$claudio_path/target/release/claudio" .local/bin/claudio
"$claudio_path/target/release/claudio" install-claude-code
