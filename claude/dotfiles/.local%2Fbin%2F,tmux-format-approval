#!/bin/sh

set -eu

# Prints y, the key that opens the approval queue, when a request waits in the queue of the project named by the argument
# Prints three spaces otherwise, so whatever comes before them in the status line stays put
# A status command gets tmux's global environment, not the session's, so the project comes as an argument
# Outside a project, like in the home session, there is no queue to count, so nothing waits
count=$(DOTDEV_PROJECT="$1" ,approval count 2> /dev/null || echo 0)
if [ "$count" -gt 0 ]; then
    printf ' #[reverse]y#[noreverse] '
else
    printf '   '
fi
