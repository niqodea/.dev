#!/usr/bin/env python3
"""Show the conversation of the session's Claude in a view pane, as Markdown with its lines unwrapped.

Claude Code wraps lines to the pane's width, so text copied from the screen has line breaks it
never had. Its transcript holds the text as it was written, which the view can copy from.
"""

import json
import subprocess


def main() -> None:
    panes = run(
        [
            "tmux",
            "list-panes",
            "-s",
            "-F",
            "#{@pane_type}\t#{@claude_transcript}",
        ]
    ).splitlines()
    # A session has at most one Claude
    claude = next((pane for pane in panes if pane.startswith("claude\t")), None)
    if claude is None:
        run(["tmux", "display-message", "No Claude in this session"])
        return
    transcript = claude.split("\t")[1]
    # The hook that stores the transcript runs when Claude starts, so a Claude started before it has none
    if not transcript:
        run(["tmux", "display-message", "No transcript known for this Claude"])
        return
    with open(transcript) as file:
        markdown = render([json.loads(line) for line in file])
    subprocess.run([",tmux-view", "md"], input=markdown, text=True, check=True)


def render(entries: list[dict]) -> str:
    sections = []
    speaker = None
    for entry in entries:
        # Meta entries and compaction summaries are context Claude Code adds, which the screen does not show
        if (
            entry["type"] not in ("user", "assistant")
            or entry.get("isMeta")
            or entry.get("isCompactSummary")
        ):
            continue
        content = entry["message"]["content"]
        if isinstance(content, str):
            content = [{"type": "text", "text": content}]
        # Only what we and Claude wrote is kept, so tool calls and their results are left out
        for block in content:
            if block["type"] != "text":
                continue
            if entry["type"] != speaker:
                speaker = entry["type"]
                sections.append("## You" if speaker == "user" else "## Claude")
            sections.append(block["text"].strip())
    return "\n\n".join(sections) + "\n"


def run(command: list[str]) -> str:
    return subprocess.run(command, capture_output=True, text=True, check=True).stdout


if __name__ == "__main__":
    main()
