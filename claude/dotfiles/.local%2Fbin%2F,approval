#!/usr/bin/env python3
"""Runs the actions CLIs request: right away when the CLI's auto-approved file
lists the request, otherwise once a person decides on it, through the list and
decide commands.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Literal, assert_never

type Json = None | bool | int | float | str | list[Json] | dict[str, Json]
type Decision = Literal["approve", "refuse"]

# A name becomes part of a path, so it may not climb out of its directory
NAME_PATTERN = re.compile(r"[a-z0-9][a-z0-9-]*")
# The same for the queue's name, which becomes a directory too
QUEUE_PATTERN = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")
# Long enough for a write over the network, short enough that a stuck action
# does not hold the person deciding
ACTION_TIMEOUT_SECONDS = 60
# Few enough that the person reads every one, and the agent waits for decisions
# instead of piling up more
MAX_PENDING_JOBS = 5
STATUS_ANSWERED_COUNT = 10


@dataclass(frozen=True)
class Request:
    cli: str
    action: str
    arguments: tuple[str, ...]


@dataclass(frozen=True)
class Job:
    request: Request
    # What the action's describe printed, one cell per column
    columns: tuple[str, ...]
    # Every name and value worth reading before deciding, like an email's
    # recipient and text, in the order describe printed them
    fields: tuple[tuple[str, str], ...]


@dataclass(frozen=True)
class QueuedJob:
    # Named by the time the job was queued, in nanoseconds
    path: Path
    job: Job


@dataclass(frozen=True)
class Succeeded:
    job: Job
    # What the action printed
    output: str


@dataclass(frozen=True)
class Refused:
    job: Job


@dataclass(frozen=True)
class Failed:
    job: Job
    # The last line the action printed to stderr, like why the change was
    # rejected
    error: str


type Outcome = Succeeded | Refused | Failed


@dataclass(frozen=True)
class AnsweredJob:
    outcome: Outcome
    at_ns: int


class InvalidRequest(Exception):
    """A request that names no installed action, or that its action rejects."""


def main() -> None:
    parser = argparse.ArgumentParser(
        description="Run the actions CLIs request, right away or once a person"
        " approves them.",
        epilog="""\
examples:
  ,approval submit avatar approve-consent prod c8169abc-… 2026-10-29T11:00:00Z
                                   request a CLI's action
  ,approval status                 what waits, and what was decided
  ,approval decide 1793289000000000000 approve
                                   approve a request, as a front end does
""",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    commands = parser.add_subparsers(dest="command", required=True)
    submit_parser = commands.add_parser(
        "submit", help="run a CLI's action, or queue it for a person to decide on"
    )
    submit_parser.add_argument("cli")
    submit_parser.add_argument("action")
    submit_parser.add_argument("arguments", nargs=argparse.REMAINDER)
    commands.add_parser("status", help="print what waits, and what was decided")
    commands.add_parser(
        "list", help="print the waiting requests as JSON, for a front end"
    )
    commands.add_parser("count", help="print how many requests wait, for a front end")
    decide_parser = commands.add_parser(
        "decide",
        help="approve or refuse a waiting request, and print its outcome as JSON",
    )
    decide_parser.add_argument("id", help="the request's id, as list prints it")
    decide_parser.add_argument("decision", choices=("approve", "refuse"))

    args = parser.parse_args()
    queue_name = get_queue_name()
    match args.command:
        case "submit":
            request = Request(args.cli, args.action, tuple(args.arguments))
            try:
                submit(queue_name, request)
            except InvalidRequest as error:
                sys.exit(str(error))
        case "status":
            print_status(queue_name)
        case "list":
            print_waiting_jobs(queue_name)
        case "count":
            print(count_pending_jobs(queue_name))
        case "decide":
            decide(queue_name, args.id, args.decision)
        case _:
            raise ValueError(f"Unknown command {args.command}")


def submit(queue_name: str, request: Request) -> None:
    job = describe(request)
    if is_auto_approved(request):
        outcome = run_job(job)
        record_outcome(queue_name, outcome)
        match outcome:
            case Succeeded():
                print(format_outcome(outcome))
            case Failed():
                sys.exit(format_outcome(outcome))
            case _:
                assert_never(outcome)
        return
    if count_pending_jobs(queue_name) >= MAX_PENDING_JOBS:
        sys.exit(
            f"Not queued: {MAX_PENDING_JOBS} requests already wait for a decision"
            " in this queue"
        )
    queue(queue_name, job)
    print(
        f"waiting: {format_row(job.columns)}. Someone with write access will decide"
        " whether to do it"
    )


def get_action_path(request: Request) -> Path:
    path = locate_action(request)
    is_named_plainly = all(
        NAME_PATTERN.fullmatch(name) for name in (request.cli, request.action)
    )
    if not is_named_plainly or not path.is_file():
        raise InvalidRequest(f"No such request: {request.cli} {request.action}")
    return path


def locate_action(request: Request) -> Path:
    return get_clis_directory() / request.cli / "actions" / request.action


def describe(request: Request) -> Job:
    """Run the action's describe, which checks the request's arguments, and
    return the job with the row and the fields it printed.
    """
    action_path = get_action_path(request)
    try:
        result = run_action(action_path, "describe", request.arguments)
    except subprocess.TimeoutExpired:
        raise InvalidRequest(
            f"Invalid request: took over {ACTION_TIMEOUT_SECONDS} s to describe"
        )
    if result.returncode != 0:
        raise InvalidRequest(f"Invalid request: {get_error(result)}")
    try:
        match json.loads(result.stdout):
            case {"row": list(row), "fields": list(fields)}:
                return Job(request, decode_strings(row), decode_fields(fields))
            case description:
                raise ValueError(f"Unexpected description {description}")
    except ValueError as error:
        raise InvalidRequest(
            f"Invalid request: describe printed no row and fields: {error}"
        )


def is_auto_approved(request: Request) -> bool:
    """Whether a line of the CLI's auto-approved file equals the request's first
    words, the action and its first arguments.
    """
    path = get_clis_directory() / request.cli / "auto-approved"
    if not path.exists():
        return False
    lines = path.read_text().splitlines()
    words = [request.action, *request.arguments]
    for line in lines:
        rule = line.split()
        if len(rule) == 0 or rule[0].startswith("#"):
            continue
        if words[: len(rule)] == rule:
            return True
    return False


def queue(queue_name: str, job: Job) -> None:
    directory = get_pending_directory(queue_name)
    directory.mkdir(parents=True, exist_ok=True)
    path = directory / f"{time.time_ns()}.json"
    path.write_text(json.dumps(encode_job(job)))


def print_status(queue_name: str) -> None:
    now_ns = time.time_ns()
    queued_jobs = read_queued_jobs(queue_name)
    print(f"waiting ({len(queued_jobs)} of at most {MAX_PENDING_JOBS}):")
    for queued_job in queued_jobs:
        age = format_age(now_ns - get_queued_at_ns(queued_job.path))
        print(f"  {age}  {format_row(queued_job.job.columns)}")
    answered_jobs = read_answered_jobs(queue_name)
    shown = answered_jobs[-STATUS_ANSWERED_COUNT:]
    print(f"answered (last {len(shown)} of {len(answered_jobs)}):")
    for answered_job in shown:
        age = format_age(now_ns - answered_job.at_ns)
        print(f"  {age}  {format_outcome(answered_job.outcome)}")


def print_waiting_jobs(queue_name: str) -> None:
    queued_jobs = read_queued_jobs(queue_name)
    jobs: list[Json] = [
        {
            "id": queued_job.path.stem,
            "queued_at_ns": get_queued_at_ns(queued_job.path),
            "columns": list(queued_job.job.columns),
            "fields": encode_fields(queued_job.job.fields),
        }
        for queued_job in queued_jobs
    ]
    print(json.dumps({"queue": queue_name, "jobs": jobs}))


def decide(queue_name: str, id_: str, decision: Decision) -> None:
    path = get_pending_directory(queue_name) / f"{id_}.json"
    # An id becomes part of a path, so it may only hold digits
    if not id_.isdigit() or not path.exists():
        sys.exit(f"No request {id_} waits in this queue")
    job = decode_job(json.loads(path.read_text()))
    outcome: Outcome
    match decision:
        case "approve":
            outcome = run_job(job)
        case "refuse":
            outcome = Refused(job)
        case _:
            assert_never(decision)
    record_outcome(queue_name, outcome)
    path.unlink()
    print(json.dumps(encode_outcome(outcome)))


def run_job(job: Job) -> Succeeded | Failed:
    action_path = locate_action(job.request)
    try:
        result = run_action(action_path, "run", job.request.arguments)
    except subprocess.TimeoutExpired:
        return Failed(job, f"took over {ACTION_TIMEOUT_SECONDS} s")
    # Like an action without its execute bit, which fails its job instead of
    # crashing ,approval
    except OSError as error:
        return Failed(job, str(error))
    if result.returncode != 0:
        return Failed(job, get_error(result))
    return Succeeded(job, result.stdout.strip())


def run_action(
    action_path: Path, verb: Literal["describe", "run"], arguments: Sequence[str]
) -> subprocess.CompletedProcess[str]:
    # Only PATH, to find programs, and HOME, to find the person's logins, so an
    # action gets the same environment whoever runs it, and names everything
    # else it acts on itself
    environment = {"PATH": os.environ["PATH"], "HOME": os.environ["HOME"]}
    return subprocess.run(
        [action_path, verb, *arguments],
        check=False,
        capture_output=True,
        text=True,
        env=environment,
        timeout=ACTION_TIMEOUT_SECONDS,
    )


def get_error(result: subprocess.CompletedProcess[str]) -> str:
    lines = result.stderr.strip().splitlines()
    return lines[-1] if len(lines) > 0 else f"exited with {result.returncode}"


def record_outcome(queue_name: str, outcome: Outcome) -> None:
    path = get_log_path(queue_name)
    path.parent.mkdir(parents=True, exist_ok=True)
    answered_job = AnsweredJob(outcome, time.time_ns())
    with path.open("a") as file:
        file.write(json.dumps(encode_answered_job(answered_job)) + "\n")


def read_queued_jobs(queue_name: str) -> list[QueuedJob]:
    queued_jobs: list[QueuedJob] = []
    for path in sorted(get_pending_directory(queue_name).glob("*.json")):
        text = path.read_text()
        queued_jobs.append(QueuedJob(path, decode_job(json.loads(text))))
    return queued_jobs


def read_answered_jobs(queue_name: str) -> list[AnsweredJob]:
    path = get_log_path(queue_name)
    if not path.exists():
        return []
    lines = path.read_text().splitlines()
    return [decode_answered_job(json.loads(line)) for line in lines]


def count_pending_jobs(queue_name: str) -> int:
    return len(list(get_pending_directory(queue_name).glob("*.json")))


def get_queued_at_ns(path: Path) -> int:
    return int(path.stem)


def encode_job(job: Job) -> dict[str, Json]:
    return {
        "cli": job.request.cli,
        "action": job.request.action,
        "arguments": list(job.request.arguments),
        "columns": list(job.columns),
        "fields": encode_fields(job.fields),
    }


def decode_job(item: object) -> Job:
    match item:
        case {
            "cli": str(cli),
            "action": str(action),
            "arguments": list(arguments),
            "columns": list(columns),
            "fields": list(fields),
        }:
            request = Request(cli, action, decode_strings(arguments))
            return Job(request, decode_strings(columns), decode_fields(fields))
        case _:
            raise ValueError(f"Unexpected job {item}")


def decode_strings(items: Sequence[object]) -> tuple[str, ...]:
    strings = tuple(item for item in items if isinstance(item, str))
    if len(strings) != len(items):
        raise ValueError(f"Expected only strings: {items}")
    return strings


def encode_fields(fields: Sequence[tuple[str, str]]) -> list[Json]:
    return [[name, value] for name, value in fields]


def decode_fields(items: Sequence[object]) -> tuple[tuple[str, str], ...]:
    fields: list[tuple[str, str]] = []
    for item in items:
        match item:
            case [str(name), str(value)]:
                fields.append((name, value))
            case _:
                raise ValueError(f"Unexpected field {item}")
    return tuple(fields)


def encode_outcome(outcome: Outcome) -> dict[str, Json]:
    match outcome:
        case Succeeded(_, output):
            return {"result": "succeeded", "output": output}
        case Refused():
            return {"result": "refused"}
        case Failed(_, error):
            return {"result": "failed", "error": error}
        case _:
            assert_never(outcome)


def encode_answered_job(answered_job: AnsweredJob) -> dict[str, Json]:
    outcome = answered_job.outcome
    return {
        "answered_at_ns": answered_job.at_ns,
        "job": encode_job(outcome.job),
        **encode_outcome(outcome),
    }


def decode_answered_job(item: object) -> AnsweredJob:
    match item:
        case {
            "answered_at_ns": int(at_ns),
            "result": "succeeded",
            "job": job,
            "output": str(output),
        }:
            return AnsweredJob(Succeeded(decode_job(job), output), at_ns)
        case {"answered_at_ns": int(at_ns), "result": "refused", "job": job}:
            return AnsweredJob(Refused(decode_job(job)), at_ns)
        case {
            "answered_at_ns": int(at_ns),
            "result": "failed",
            "job": job,
            "error": str(error),
        }:
            return AnsweredJob(Failed(decode_job(job), error), at_ns)
        case _:
            raise ValueError(f"Unexpected answered job {item}")


def format_row(columns: Sequence[str]) -> str:
    return "  ".join(columns)


def format_outcome(outcome: Outcome) -> str:
    match outcome:
        case Succeeded(job, output):
            row = format_row(job.columns)
            return f"succeeded: {row}: {output}" if output else f"succeeded: {row}"
        case Refused(job):
            return f"refused: {format_row(job.columns)}"
        case Failed(job, error):
            return f"failed: {format_row(job.columns)}: {error}"
        case _:
            assert_never(outcome)


def format_age(age_ns: int) -> str:
    """Write the age in at most three characters, like 5m, 12h or 3d."""
    minutes = age_ns // 60_000_000_000
    if minutes < 60:
        return f"{minutes}m".rjust(3)
    if minutes < 48 * 60:
        return f"{minutes // 60}h".rjust(3)
    return f"{minutes // (24 * 60)}d".rjust(3)


def get_queue_name() -> str:
    """Return the name of the queue to use, which APPROVAL_QUEUE holds."""
    queue_name = os.environ.get("APPROVAL_QUEUE")
    if queue_name is None:
        sys.exit("APPROVAL_QUEUE is not set, so there is no queue to use")
    if QUEUE_PATTERN.fullmatch(queue_name) is None:
        sys.exit(f"APPROVAL_QUEUE is {queue_name}, which is not a plain name")
    return queue_name


def get_clis_directory() -> Path:
    """Return where each CLI installs its actions and auto-approved file, under
    clis/<cli>.
    """
    return Path.home() / ".config/approval/clis"


def get_pending_directory(queue_name: str) -> Path:
    return get_queue_directory(queue_name) / "pending"


def get_log_path(queue_name: str) -> Path:
    return get_queue_directory(queue_name) / "log.jsonl"


def get_queue_directory(queue_name: str) -> Path:
    return Path.home() / ".local/state/approval" / queue_name


if __name__ == "__main__":
    main()
