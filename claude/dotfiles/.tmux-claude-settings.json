{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @status idle \\; refresh-client -S"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @status running \\; refresh-client -S"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @status running \\; refresh-client -S"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @status idle \\; refresh-client -S"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "tmux set-option -p -t \"$TMUX_PANE\" @status idle \\; refresh-client -S"
          }
        ]
      }
    ]
  }
}
