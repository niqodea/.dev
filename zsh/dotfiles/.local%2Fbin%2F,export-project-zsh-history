#!/bin/sh

set -eu

if [ -z "${DOTDEV_PROJECT-}" ]; then
    >&2 echo 'Not in a project'
    exit 1
fi

project_path="$HOME/$DOTDEV_PROJECT/$DOTDEV_ATDIR/project"
history_path="$project_path/history.zsh"
# Holds the timestamp of the newest command already in the global history, which, unlike a line
# number, stays valid when zsh trims the oldest lines of the project history
exported_path="$project_path/exported"

if [ ! -e "$history_path" ]; then
    echo 'Nothing to export'
    exit
fi

if [ -e "$exported_path" ]; then
    exported="$(cat "$exported_path")"
else
    exported=-1 # Nothing exported yet, so even commands without a timestamp (0) are exported
fi

# A line looks like ": <timestamp>:<duration>;<command>". The continuation lines of a multi-line
# command have no timestamp of their own, and a command saved without EXTENDED_HISTORY counts as 0
# $0 is awk's current line, so the shell must not expand it
# shellcheck disable=SC2016
with_timestamp='/^: [0-9]+:[0-9]+;/ { split($0, fields, /[:;]/); timestamp = fields[2] + 0 }'

# Read first, so commands added during the copy wait for the next export
newest="$(awk "$with_timestamp"' { if (timestamp > newest) newest = timestamp } END { print newest + 0 }' "$history_path")"

if [ "$newest" -le "$exported" ]; then
    echo 'Nothing to export'
    exit
fi

# awk has no long form of -v, which sets an awk variable from the shell
awk -v exported="$exported" -v newest="$newest" -v global_path="$HOME/.zsh_history" "$with_timestamp"'
    timestamp > exported && timestamp <= newest { print >> global_path; count++ }
    END { printf "Exported %d lines\n", count }
' "$history_path"
echo "$newest" > "$exported_path"
