alias ,l='ls --color=auto'
alias ,la='ls --color=auto -a'
alias ,ll='ls --color=auto -hl'
alias ,lal='ls --color=auto -ahl'

alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'

alias ,duh='du -hs'

alias ,fn='find . -name'

alias ,psg='ps -eo pid,user,etime,comm | grep'
alias ,k9='kill -9'

# Load the commands other shells have added to the history
alias ,fcr='fc -R'

alias ,pp='pwd -P'
