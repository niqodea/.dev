#!/bin/sh

set -eu

if [ -z "${DOTDEV_PROJECT-}" ]; then
    >&2 echo 'Not in a project'
    exit 1
fi

project_path="$HOME/$DOTDEV_PROJECT/$DOTDEV_ATDIR/project"
history_path="$project_path/history.zsh"
# Timestamp of the newest command already in global, which unlike a line number survives zsh
# trimming the oldest lines of the project history
imported_path="$project_path/imported"

if [ ! -e "$history_path" ]; then
    echo 'Nothing to import'
    exit
fi

if [ -e "$imported_path" ]; then
    imported="$(cat "$imported_path")"
else
    imported=-1 # Nothing imported yet, so even commands without a timestamp (0) are imported
fi

# Lines look like ": <timestamp>:<duration>;<command>", continuation lines of a multi-line
# command have no timestamp of their own, and commands saved without EXTENDED_HISTORY count as 0
# $0 is awk's current line, so the shell must not expand it
# shellcheck disable=SC2016
with_timestamp='/^: [0-9]+:[0-9]+;/ { split($0, fields, /[:;]/); timestamp = fields[2] + 0 }'

# Fixed first, so that commands appended while we copy wait for the next import
newest="$(awk "$with_timestamp"' { if (timestamp > newest) newest = timestamp } END { print newest + 0 }' "$history_path")"

if [ "$newest" -le "$imported" ]; then
    echo 'Nothing to import'
    exit
fi

# awk has no long form of -v, which sets an awk variable from the shell
awk -v imported="$imported" -v newest="$newest" -v global_path="$HOME/.zsh_history" "$with_timestamp"'
    timestamp > imported && timestamp <= newest { print >> global_path; count++ }
    END { printf "Imported %d lines\n", count }
' "$history_path"
echo "$newest" > "$imported_path"
