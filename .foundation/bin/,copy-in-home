#!/bin/sh

set -eu

backup_path="$1"
source_path="$2"
home_relative_path="$3"

if [ -d "$source_path" ]; then
    >&2 echo "Error: $source_path is a folder, but ,copy-in-home only copies files"
    exit 1
fi

target_path="$HOME/$home_relative_path"
if [ -e "$target_path" ] || [ -h "$target_path" ]; then
    if cmp -s "$source_path" "$target_path"; then
        exit
    fi
    # The old file goes into the backup, so nothing is lost
    mkdir -p "$(dirname "$backup_path/$home_relative_path")"
    mv "$target_path" "$backup_path/$home_relative_path"
fi
mkdir -p "$(dirname "$target_path")"
cp "$source_path" "$target_path"
