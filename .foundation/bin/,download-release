#!/bin/sh

set -eu

# Downloads a program's release file, checks its sha256 and unpacks it into ~/.local/opt/<program>-<version>, then prints that path
# The file is a .tar.gz archive, a .zip archive with its files at the top, a .gz of the executable <program>, or that executable itself
url="$1"
sha256="$2"
program="$3"
version="$4"

path="$HOME/.local/opt/$program-$version"
if [ ! -e "$path" ]; then
    mkdir -p "$HOME/.local/opt"
    tmp="$(mktemp -d "$HOME/.local/opt/.$program.XXXXXX")"
    trap 'rm -rf "$tmp"' EXIT
    curl --fail --silent --show-error --location --max-time 300 --output "$tmp/download" "$url"
    ,check-sha256 "$sha256" "$tmp/download"
    mkdir "$tmp/$program"
    case "$url" in
        *.tar.gz)
            # Most archives wrap their files in one folder, which is dropped, but some put them at the top
            if tar -tzf "$tmp/download" | grep --quiet --invert-match /; then
                tar -xf "$tmp/download" -C "$tmp/$program"
            else
                tar -xf "$tmp/download" -C "$tmp/$program" --strip-components=1
            fi
            ;;
        *.zip)
            unzip -q "$tmp/download" -d "$tmp/$program"
            ;;
        *.gz)
            gunzip --to-stdout "$tmp/download" > "$tmp/$program/$program"
            chmod +x "$tmp/$program/$program"
            ;;
        *)
            mv "$tmp/download" "$tmp/$program/$program"
            chmod +x "$tmp/$program/$program"
            ;;
    esac
    mv "$tmp/$program" "$path"
fi
echo "$path"
