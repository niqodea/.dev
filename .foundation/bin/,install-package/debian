#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    >&2 echo "Error: no package specified"
    exit 1
fi

codename="$(. /etc/os-release && echo "$VERSION_CODENAME")"

# Takes the backports version where there is one, and the release's own version otherwise
sudo apt install --target-release "$codename-backports" "$@"
