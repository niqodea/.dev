#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    >&2 echo "Error: no package specified"
    exit 1
fi

prefix="$("$HOME/.local/bin/,get-package-prefix")"
# brew is called by its full path, so it works whatever PATH holds
# A package already installed keeps its version, since an upgrade can restart a running service, and upgrading is left to the user
HOMEBREW_NO_INSTALL_UPGRADE=1 "$prefix/bin/brew" install "$@"
