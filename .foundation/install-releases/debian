#!/bin/sh

set -eu

backup_path="$1"

shfmt_version='v3.14.1'

# Each download's sha256 changes with the version above, and comes from the release's own digest on GitHub
case "$(uname -m)" in
    'aarch64')
        shfmt_arch='arm64'
        shfmt_sha256='5f2db09dae91fca848f7adbdd014632e921a383863a2ad7e0450ad3aba0c6489'
        ;;
    'x86_64')
        shfmt_arch='amd64'
        shfmt_sha256='76e77641faa025814b77f153b29796b8e6fa2fca03e0c76a691608b86c7ea7bf'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# Debian 13 has shfmt 3.8, which is too old for this setup
shfmt_path="$("$HOME/.local/bin/,download-release" "https://github.com/mvdan/sh/releases/download/$shfmt_version/shfmt_${shfmt_version}_linux_$shfmt_arch" "$shfmt_sha256" shfmt "$shfmt_version")"
"$HOME/.local/bin/,link-in-local-bin" "$backup_path" "$shfmt_path/shfmt" shfmt
