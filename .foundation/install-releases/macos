#!/bin/sh

set -eu

backup_path="$1"

fzf_version='0.74.5'
shfmt_version='v3.14.1'

# Each download's sha256 changes with the versions above, and comes from the release's own digest on GitHub
case "$(uname -m)" in
    'arm64')
        fzf_arch='arm64'
        fzf_sha256='ada808c7401b9949ce8842274ac16a6b6193fd32dcada396884a6a9a89e5985a'
        shfmt_sha256='b7c872db63553ccffc7253aba3ed7d4885a27d83f1ba567b1138c6315a5847e5'
        ;;
    'x86_64')
        fzf_arch='amd64'
        fzf_sha256='aca6cab692e6c069e724a43070a448e18586c7c0fdd1139f6d487ec1680599ed'
        shfmt_sha256='d33eee0da0f92835b3562e9767a05cee7e4eaeef47daa03bfd09da17b4b590a6'
        ;;
    *)
        >&2 echo "Unsupported processor: $(uname -m)"
        exit 1
        ;;
esac

# Downloaded as on Debian, where the package is too old
fzf_path="$("$HOME/.local/bin/,download-release" "https://github.com/junegunn/fzf/releases/download/v$fzf_version/fzf-$fzf_version-darwin_$fzf_arch.tar.gz" "$fzf_sha256" fzf "$fzf_version")"
"$HOME/.local/bin/,link-in-local-bin" "$backup_path" "$fzf_path/fzf" fzf

# Downloaded as on Debian, where the package is too old
shfmt_path="$("$HOME/.local/bin/,download-release" "https://github.com/mvdan/sh/releases/download/$shfmt_version/shfmt_${shfmt_version}_darwin_$fzf_arch" "$shfmt_sha256" shfmt "$shfmt_version")"
"$HOME/.local/bin/,link-in-local-bin" "$backup_path" "$shfmt_path/shfmt" shfmt
