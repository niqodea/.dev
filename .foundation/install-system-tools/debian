#!/bin/sh

set -eu

# A fresh machine can have no package lists, or outdated ones, and then apt cannot find or download packages
sudo apt update
# curl downloads rustup, and Rust links its programs with the system's C compiler and C library
sudo apt install curl gcc libc6-dev
# The installers place every file with rsync, which a minimal Debian does not have
sudo apt install rsync
# ,list-project-listeners finds servers with lsof, which a minimal Debian does not have
sudo apt install lsof
