#!/bin/sh

case "$(uname -s)" in
    'Darwin')
        echo 'macos'
        exit
        ;;
    'Linux')
        if [ -f /etc/debian_version ]; then
            echo 'debian'
            exit
        fi
        ;;
    *)
        # Any other system falls through to the error below
        ;;
esac

>&2 echo "Error: unknown operating system"
exit 1
